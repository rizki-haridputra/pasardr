	<style>
.kios-card {
    transition: transform 0.3s, box-shadow 0.3s;
    cursor: pointer;
}
.kios-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
}
.kios-image {
    height: 200px;
    object-fit: cover;
    transition: transform 0.3s;
    width: 100%;
}
.kios-card:hover .kios-image {
    transform: scale(1.05);
}
.badge {
    padding: 0.4em 0.75em;
    font-size: 0.75rem;
    border-radius: 0.5rem;
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    color: white;
    font-weight: 600;
}
.badge-success {
    background-color: #28a745; /* hijau */
}
.badge-secondary {
    background-color: #6c757d; /* abu */
}
</style>

				<script>
				document.addEventListener('DOMContentLoaded', function () {
					const filterJenis = document.getElementById('filterJenis');
					const filterStatus = document.getElementById('filterStatus');
					const kiosItems = document.querySelectorAll('.kios-item');

					function filterKios() {
						const selectedJenis = filterJenis.value;
						const selectedStatus = filterStatus.value;

						kiosItems.forEach(item => {
							const itemJenis = item.getAttribute('data-jenis');
							const itemStatus = item.getAttribute('data-status');

							const jenisMatch = (selectedJenis === 'all') || (itemJenis === selectedJenis);
							const statusMatch = (selectedStatus === 'all') || (itemStatus === selectedStatus);

							if (jenisMatch && statusMatch) {
								item.style.display = 'block';
							} else {
								item.style.display = 'none';
							}
						});
					}

					filterJenis.addEventListener('change', filterKios);
					filterStatus.addEventListener('change', filterKios);
				});
				</script>

	
	<section class="content">
    <div class="container-fluid">

        

        <!-- FILTERS -->
        <div class="row mb-4">
            <div class="col-md-6">
                <label for="filterJenis" class="form-label fw-bold">Filter Jenis Kios:</label>
                <select id="filterJenis" class="form-select">
                    <option value="all">Semua Jenis</option>
                    <?php
                    // Ambil list jenis kios unik dari data
                    $jenisList = [];
                    foreach ($Kios->result_array() as $row) {
                        if (!in_array($row['jKios'], $jenisList)) {
                            $jenisList[] = $row['jKios'];
                        }
                    }
                    foreach ($jenisList as $jenis) {
                        echo '<option value="' . htmlspecialchars($jenis) . '">' . htmlspecialchars($jenis) . '</option>';
                    }
                    ?>
                </select>
            </div>
            <div class="col-md-6">
                <label for="filterStatus" class="form-label fw-bold">Filter Status:</label>
                <select id="filterStatus" class="form-select">
                    <option value="all">Semua Status</option>
                    <option value="tersedia">Tersedia</option>
                    <option value="disewa">Sudah Disewa</option>
                </select>
            </div>
        </div>

        <!-- KATALOG KIOS -->
        <div class="row" id="kiosContainer">
            <?php foreach ($Kios->result_array() as $row) {
                $tersedia = empty($row['penyewa']);
                // data attributes untuk filter
            ?>
                <div class="col-lg-3 col-md-4 col-sm-6 mb-4 kios-item"
                     data-jenis="<?= htmlspecialchars($row['jKios']) ?>"
                     data-status="<?= $tersedia ? 'tersedia' : 'disewa' ?>">
                    <div class="card h-100 shadow-sm border-0 kios-card position-relative">
                        <div class="position-relative overflow-hidden">
                            <?php if ($row['gambar']) { ?>
                                <img src="<?= base_url('assets/img/kios/' . $row['gambar']) ?>" class="card-img-top kios-image" alt="Gambar Kios">
                            <?php } else { ?>
                                <img src="<?= base_url('assets/img/no-image.png') ?>" class="card-img-top kios-image" alt="Tidak Ada Gambar">
                            <?php } ?>
                            <span class="badge badge-<?= $tersedia ? 'success' : 'secondary' ?> position-absolute top-0 start-0 m-2">
                                <?= $tersedia ? 'Tersedia' : 'Sudah Disewa' ?>
                            </span>
                        </div>
                        <div class="card-body p-3">
                            <h6 class="card-title mb-1 text-truncate"><?= $row['jKios'] ?></h6>
                            <p class="text-danger fw-bold mb-1">Rp <?= number_format($row['hKios'], 0, ',', '.') ?></p>
                            <small class="text-muted d-block">ID: <?= $row['idKios'] ?></small>
                            <small class="text-muted d-block mb-2">Penyewa: <?= $row['penyewa'] ?: '-' ?></small>

                            <?php if ($this->session->userdata('level') == 'Administrator') { ?>
                                <button class="btn btn-sm btn-warning w-100" data-toggle="modal" data-target="#editData<?= $row['id'] ?>">
                                    <i class="fa fa-edit"></i> Edit
                                </button>
                            <?php } ?>
                        </div>
                    </div>
                </div>
            <?php } ?>
        </div>
    </div>
</section>



</div>
