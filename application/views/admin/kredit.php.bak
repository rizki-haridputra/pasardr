                        </thead>
                        <tbody>
                            <?php 
                            $no = 1;
                            foreach ($kredit as $row): 
                                $nasabah = $row->Nasabah;
                                $totalTerbayar = $row->totalTerbayar;
                            ?>
                                <tr>
                                    <td><?= $no++ ?></td>
                                    <td><?= $row->noKredit ?></td>
                                    <td><?= $nasabah ? htmlspecialchars($nasabah->nama) : '-' ?></td>
                                    <td><?= htmlspecialchars($row->namaBarang) ?></td>
                                    <td><?= 'Rp. ' . number_format($row->harga,0,',','.') ?></td>
                                    <td><?= 'Rp. ' . number_format($totalTerbayar,0,',','.') ?></td>
                                    <td><?= date('d F Y', strtotime($row->tanggal)) ?></td>
                                    <td>
                                        <div class="label label-<?= ($row->status == 'Lunas') ? 'success' : 'danger' ?>">
                                            <?= $row->status ?>
                                        </div>
                                    </td>
                                    <td>
                                        <a href="<?= base_url('admin/angsuran/pembayaran/'.$row->id) ?>" class="btn btn-success btn-xs">
                                            <div class="fa fa-history"></div> History
                                        </a>
                                        <?php if($this->session->userdata('level') == 'Administrator'): ?>
                                            <button class="btn btn-warning btn-xs" data-toggle="modal" data-target="#editData<?= $row->id ?>">
                                                <div class="fa fa-edit"></div> Edit
                                            </button>
                                            <?php if($row->status == 'Belum Lunas'): ?>
                                                <a href="<?= base_url('admin/kredit/delete/'.$row->id) ?>" class="btn btn-danger btn-xs tombol-yakin" data-isidata="Ingin menghapus data ini?">
                                                    <div class="fa fa-trash"></div> Delete
                                                </a>
                                            <?php endif; ?>
                                        <?php endif; ?>
                                    </td>
                                </tr>
                            <?php endforeach; ?>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>

