                                            ?>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Sisa Pembayaran</td>
                                        <td>:</td>
                                        <td><?= 'Rp. ' . number_format($row['harga']-$tPem->totalPembayaran,0,',','.') ?></td>
                                    </tr>
                                    <tr>
                                        <td>Status</td>
                                        <td>:</td>
                                        <td><div class="label label-<?= ($row['status'] == 'Lunas') ? 'success' : 'danger' ?>"><?= $row['status'] ?></div></td>
