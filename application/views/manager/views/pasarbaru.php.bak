    <style>
        /* CSS Dasar (dari kode Anda) - TIDAK ADA PERUBAHAN */
        :root {
            --font-utama: 'Poppins', sans-serif;
            --warna-berisi: #a8d08d; --warna-berisi-gelap: #82b36a;
            --warna-kosong: #ffffff; --warna-kosong-gelap: #e0e0e0;
            --warna-teks: #333; --radius-sudut: 8px; --bayangan: 0 4px 15px rgba(0,0,0,0.08);
            --celah-kios: 0px; --celah-blok: 15px; --celah-grup-inti: 20px;
            --lebar-kios-tengah: 36px;
            --lebar-kios-samping: 55px;
        }
        .denah-container * { box-sizing: border-box; }
        .denah-container { font-family: var(--font-utama); background-color: #f7f9fc; padding: 25px; border-radius: var(--radius-sudut); width: 100%; overflow-x: auto; text-align: center; }
        .denah-title { text-align: center; font-weight: 700; font-size: 2em; margin-bottom: 30px; letter-spacing: 1px; color: var(--warna-teks); }
        .denah-layout { display: inline-flex; flex-direction: column; gap: 0; text-align: left; }
        .denah-baris-atas, .denah-baris-bawah { display: grid; grid-template-columns: 1fr 1fr; gap: var(--celah-blok); }
        .denah-tengah { display: flex; gap: var(--celah-blok); align-items: start; }
        .blok-horizontal { display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--celah-kios); }
        .blok-vertikal { display: grid; grid-template-rows: repeat(8, 1fr); gap: var(--celah-kios); }
        .panah-vertikal { font-size: 2.5em; font-weight: bold; color: #bbb; text-align: center; margin: 10px 0; }
        .kolom-inti-wrapper { display: flex; flex-direction: column; gap: 0; }
        .pemisah-inti { text-align: center; font-weight: bold; color: #ccc; font-size: 1.2em; letter-spacing: 2px; margin: 8px 0; width: 100%; }
        .blok-inti-tengah { display: flex; gap: var(--celah-kios); background-color: #fff; padding: 10px; border-radius: var(--radius-sudut); box-shadow: var(--bayangan); }
        .kolom-kios-inti { display: grid; grid-template-rows: repeat(2, 1fr); gap: var(--celah-kios); }
        .blok-inti-tengah .kolom-kios-inti:nth-child(6n):not(:last-child) { margin-right: var(--celah-grup-inti); }
        
        .kios { border: 1px solid rgba(0,0,0,0.15); padding: 8px 4px; font-size: 0.65em; font-weight: 600; text-align: center; min-height: 32px; display: flex; align-items: center; justify-content: center; border-radius: 4px; transition: all 0.2s ease-in-out; cursor: pointer; flex-shrink: 0; }
        .kios:hover { transform: scale(1.15) !important; z-index: 10; box-shadow: 0 5px 15px rgba(0,0,0,0.2); font-weight: 700; }
        
        .denah-tengah .kolom-inti-wrapper .kios { width: var(--lebar-kios-tengah); }
        .denah-tengah .blok-vertikal .kios { width: var(--lebar-kios-samping); padding: 12px 4px; }
        .blok-vertikal .kios:nth-child(4n):not(:last-child) { margin-bottom: var(--celah-blok); }
        .kios.berisi { background-color: var(--warna-berisi); border-color: var(--warna-berisi-gelap); color: #fff; }
        .kios.kosong { background-color: var(--warna-kosong); border-color: var(--warna-kosong-gelap); color: var(--warna-teks); }
        .legend { margin-top: 30px; display: flex; justify-content: center; align-items: center; gap: 25px; font-weight: 600; color: #555; }
        .legend-item { display: flex; align-items: center; gap: 8px; }
        .swatch { width: 22px; height: 22px; border-radius: 4px; }
        .scroll-hint { display: none; align-items: center; justify-content: center; gap: 10px; color: #888; font-style: italic; font-size: 0.9em; margin-top: 20px; }
        @media (max-width:1400px) { .scroll-hint { display: flex; } }

        /* === 3. CSS BARU UNTUK MODAL - TIDAK ADA PERUBAHAN === */
        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.6); z-index: 1000; display: none; justify-content: center; align-items: center; opacity: 0; transition: opacity 0.3s ease-in-out; }
        .modal-konten { background: #fff; padding: 25px 30px; border-radius: var(--radius-sudut); width: 90%; max-width: 600px; position: relative; box-shadow: 0 10px 30px rgba(0,0,0,0.2); transform: scale(0.95); transition: transform 0.3s ease-in-out; }
        body.modal-terbuka .modal-overlay { display: flex; opacity: 1; }
        body.modal-terbuka .modal-konten { transform: scale(1); }
        .modal-tutup { position: absolute; top: 10px; right: 15px; font-size: 2.5em; font-weight: bold; color: #aaa; cursor: pointer; line-height: 1; }
        .modal-tutup:hover { color: #333; }
        #modalKiosJudul { margin-top: 0; margin-bottom: 20px; font-size: 1.8em; color: var(--warna-teks); border-bottom: 2px solid #f0f0f0; padding-bottom: 15px; }
        .modal-body { display: flex; gap: 25px; }
        .modal-body img { width: 50%; max-width: 250px; height: auto; object-fit: cover; border-radius: var(--radius-sudut); border: 1px solid #ddd; }
        .modal-info { flex: 1; }
        .status-label { padding: 4px 10px; border-radius: 20px; color: #fff; font-weight: 600; font-size: 0.9em; }
        .status-label.berisi { background-color: #d9534f; }
        .status-label.kosong { background-color: #5cb85c; }
        #modalKiosDeskripsi { font-size: 0.95em; line-height: 1.6; color: #555; min-height: 60px; }
        .tombol-sewa { display: inline-block; background-color: #5cb85c; color: #fff !important; padding: 12px 25px; text-align: center; text-decoration: none; border-radius: 5px; font-weight: 600; transition: background-color 0.2s; border: none; cursor: pointer; width: 100%; margin-top: 15px; }
        .tombol-sewa:hover { background-color: #449d44; }
        .tombol-sewa.disabled { background-color: #ccc; cursor: not-allowed; pointer-events: none; }
        @media (max-width: 600px) { .modal-body { flex-direction: column; } .modal-body img { width: 100%; max-width: none; } }
    </style>
</head>
